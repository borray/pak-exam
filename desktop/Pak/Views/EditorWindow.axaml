<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Pak.Views.EditorWindow"
        Width="900" Height="720"
        MinWidth="700" MinHeight="500"
        Background="#161616"
        Title="Редактор экзамена — ПАК">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#111111" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="HeaderId" Grid.Column="0" Text=""
                           Foreground="#888" FontFamily="Consolas" VerticalAlignment="Center"/>
                <Button x:Name="SaveBtn" Grid.Column="1" Content="Сохранить"
                        Background="#f5f5f0" Foreground="#0a0a0a" Padding="18,8"/>
            </Grid>
        </Border>
        <ScrollViewer>
            <StackPanel x:Name="Root" Margin="20" Spacing="8"/>
        </ScrollViewer>
    </DockPanel>
</Window>
